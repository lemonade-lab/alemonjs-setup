{
  "description": "template app",
  "devDependencies": {
    "@types/node": "^22",
    "alemonjs": "2.1.92",
    "lvyjs": "^0.3.0-alpha.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json"
  },
  "homepage": "",
  "license": "",
  "main": "lib/index.js",
  "name": "alemonjs-app",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "app": "node index.js",
    "build": "lvy build",
    "delete": "npx pm2 delete pm2.config.cjs",
    "dev": "lvy app.ts",
    "review": "npx alemonc start",
    "start": "npx pm2 startOrRestart pm2.config.cjs",
    "stop": "npx pm2 stop pm2.config.cjs",
    "view": "lvy app.ts --jsxp"
  },
  "type": "module",
  "version": "1.0.2"
}
